summary(mod2)
mod2 <- glm(data = mpg,
formula = cty ~ displ + year + manufacturer)
summary(mod2)
mod2 <- glm(data = mpg,
formula = cty ~ displ + year + manufacturer + model + trans + cyl + drv)
summary(mod2)
performance(mod2)
mod1 <- glm(data = mpg,
formula = cty ~ displ)
mod2 <- glm(data = mpg,
formula = cty ~ displ + cyl)
mod3 <- glm(data = mpg,
formula = cty ~ displ * cyl)
summary(mod1)
summary(mod2)
summary(mod3)
mpg %>%
ggplot(aes(x = disp, y = cty, color = factor(cyl)))+
geom_smooth(method = 'glm')
mpg %>%
ggplot(aes(x = displ, y = cty, color = factor(cyl)))+
geom_smooth(method = 'glm')
