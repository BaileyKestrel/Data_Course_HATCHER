library(tidyverse)
## glm() vs anova
library(palmerpenguins)
mod <- aov(data = penguins,
formula = body_mass_g ~ species)
summary(mod)
mod <- aov(data = penguins,
formula = body_mass_g ~ species + sex)
summary(mod)
mod <- aov(data = penguins,
formula = body_mass_g ~ species + sex + year)
mod <- glm(data = penguins,
formula = body_mass_g ~ species + sex + year)
# do the same thing for glm()
mod <- glm(data = penguins,
formula = body_mass_g ~ species + sex + year)
summary(mod)
mod_aov <- aov(data = penguins,
formula = body_mass_g ~ species + sex + year)
summary(mod_aov)
# do the same thing for glm()... we are now using linear model ... gives you estimation
mod_glm <- glm(data = penguins,
formula = body_mass_g ~ species + sex + year)
summary(mod_glm)
