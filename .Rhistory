# Get a list of unique counties
unique_counties <- unique(dat_clean$county)
# Create an empty list to store results
cor_results <- list()
# Loop through each county and compute correlation
for (cnty in unique_counties) {
subset_data <- dat_clean[dat_clean$county == cnty, ]  # Filter data for the county
cor_value <- cor(subset_data$non_religious, subset_data$proportion, use = "complete.obs")
cor_results[[cnty]] <- cor_value  # Store in the list with county as key
}
# Print results
cor_results
cor_results <- lapply(unique(dat_clean$county), function(cnty) {
subset_data <- dat_clean[dat_clean$county == cnty, ]
cor(subset_data$non_religious, subset_data$proportion, use = "complete.obs")
})
# Name the results by county
names(cor_results) <- unique(dat_clean$county)
# Print results
cor_results
remove(cnty)
remove(cor_value)
remove(unique_counties)
remove(cor_results)
remove(subset_data)
# calculate Non Religious Population vs. Religion Proportion correlation
cor(dat_clean$non_religious, dat_clean$proportion, use = "complete.obs")
anyNA(dat_clean$non_religious)
anyNA(dat_clean$proportion)
