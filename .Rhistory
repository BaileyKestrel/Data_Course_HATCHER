str(dat_clean)
cor_results <- lapply(unique(dat_clean$county), function(cnty) {
subset_data <- dat_clean[dat_clean$county == cnty, ]
# Debugging: print county and count of complete cases
cat("County:", cnty, " - Complete Cases:", sum(complete.cases(subset_data$non_religious, subset_data$proportion)), "\n")
if (sum(complete.cases(subset_data$non_religious, subset_data$proportion)) >= 2) {
return(cor(subset_data$non_religious, subset_data$proportion, use = "complete.obs"))
} else {
return(NA)  # Not enough valid data
}
})
